{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "concept.schema.json",
  "title": "Visular AI Terms / Concepts - Concept",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "summary", "status", "media"],
  "properties": {
    "schemaVersion": {"const": 4},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "shortTitle": {"type": "string"},
    "summary": {"type": "string", "minLength": 1},
    "definition": {"type": "string"},
    "simpleExplanation": {"type": "string"},
    "executiveTakeaway": {"type": "string"},
    "knowledgeWorkerTakeaway": {"type": "string"},
    "keyTakeaway": {"type": "string"},
    "primaryRisk": {"type": "string"},
    "status": {"enum": ["active", "emerging", "updated", "deprecated", "archived", "draft"]},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "keywords": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "categories": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "uniqueItems": true},
    "relatedConcepts": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "uniqueItems": true},
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conceptId", "type"],
        "properties": {
          "conceptId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "type": {"enum": ["foundation", "prerequisite", "related", "enables", "uses", "governs", "governed-by", "contrasts-with", "next-concept"]},
          "label": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "prerequisites": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "uniqueItems": true},
    "learnNext": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "uniqueItems": true},
    "commonlyConfusedWith": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conceptId", "summary"],
        "properties": {
          "conceptId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "summary": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conceptId", "rows"],
        "properties": {
          "conceptId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "title": {"type": "string"},
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["aspect", "current", "other"],
              "properties": {
                "aspect": {"type": "string"},
                "current": {"type": "string"},
                "other": {"type": "string"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "summary"],
        "properties": {
          "title": {"type": "string"},
          "audience": {"enum": ["all", "senior-leader", "knowledge-worker"]},
          "summary": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "businessImpact": {
      "type": "object",
      "properties": {
        "potentialValue": {"type": "string"},
        "operationalImpact": {"type": "string"},
        "primaryRisk": {"type": "string"},
        "leadershipQuestion": {"type": "string"}
      },
      "additionalProperties": false
    },
    "questionsToAsk": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question"],
        "properties": {
          "audience": {"enum": ["all", "senior-leader", "knowledge-worker"]},
          "question": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {"type": "string"},
          "publisher": {"type": "string"},
          "url": {"type": "string"},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "replacedBy": {"type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "created": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "lastUpdated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "lastReviewed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "contentVersion": {"type": "string"},
    "reviewStatus": {"enum": ["reviewed", "draft", "needs-review"]},
    "review": {
      "type": "object",
      "properties": {
        "status": {"enum": ["reviewed", "draft", "needs-review"]},
        "reviewedDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "nextReviewDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "owner": {"type": "string"}
      },
      "additionalProperties": false
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "label", "src", "mime", "accessibility"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "type": {"enum": ["image", "video", "audio", "pdf", "docx"]},
          "label": {"type": "string"},
          "displayLabel": {"type": "string"},
          "src": {"type": "string"},
          "mime": {"type": "string"},
          "durationSeconds": {"type": "number", "minimum": 0},
          "pages": {"type": "integer", "minimum": 1},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "sizeBytes": {"type": "integer", "minimum": 0},
          "accessibility": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": {"enum": ["complete", "needs-review", "needs-remediation", "alternative-provided"]},
              "captions": {"type": ["string", "null"]},
              "transcript": {"type": ["string", "null"]},
              "accessibleAlternative": {"type": ["string", "null"]},
              "sourceTagged": {"type": ["boolean", "null"]},
              "alternativeLabel": {"type": "string"},
              "alt": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
